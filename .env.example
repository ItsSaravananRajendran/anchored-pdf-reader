# Copy this file to `.env` and fill in the values.

# Required: your MiniMax API key (https://api.minimax.io)
MINIMAX_API_KEY=*** Optional: bind address and port (default: 127.0.0.1:8910 — localhost only)
# Override if you want Tailscale/LAN access (e.g. BIND_HOST=0.0.0.0).
BIND_HOST=127.0.0.1
BIND_PORT=8910

# Optional: where to store the SQLite DB and cached PDFs (default: ./data)
# DATA_DIR=./data

# Optional: maximum bytes per PDF download (default: 52428800 = 50 MB)
# PDF_MAX_BYTES=52428800

# Optional: max characters of page text sent to the LLM (default: 8000)
# PAGE_TEXT_MAX_CHARS=8000